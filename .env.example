# Copy to .env locally. Never commit .env, JWTs or Tunnel credentials.
# PR-2 direct mcp-for-blender CLI reads process environment, not .env automatically.
# Export the values first, e.g. PowerShell:
# $env:GOODMCP_PUBLIC_URL = 'https://goodmcp.si/mcp'
# $env:GOODMCP_ACCESS_TEAM_DOMAIN = 'YOUR-TEAM.cloudflareaccess.com'
# $env:GOODMCP_ACCESS_AUD = 'YOUR-ACCESS-APPLICATION-AUD'
# $env:GOODMCP_ALLOWED_EMAIL = 'YOUR-OWNER-EMAIL'
# PR-3 start-goodmcp.ps1 loads .env; existing process environment takes precedence.
# Use https://mcp.goodmcp.si/mcp instead ONLY if apex is already occupied.
GOODMCP_PUBLIC_URL=https://goodmcp.si/mcp
GOODMCP_ACCESS_TEAM_DOMAIN=YOUR-TEAM.cloudflareaccess.com
GOODMCP_ACCESS_AUD=YOUR-ACCESS-APPLICATION-AUD
GOODMCP_ALLOWED_EMAIL=YOUR-OWNER-EMAIL
# Keep 0 until authentication + backup + read-only checks have passed.
# 1 also permits look(image=...) to load files outside the open scene.
GOODMCP_ALLOW_WRITE=0
BLENDER_HOST=127.0.0.1
BLENDER_PORT=9876
BLENDER_MCP_SAFE_MODE=1
DISABLE_TELEMETRY=true
# Local path to the named Tunnel's config.json, never the token itself.
GOODMCP_TUNNEL_CONFIG=
